# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/
*.spec
# PyInstaller spec 为交付产物，入仓（上方通配默认吞掉，此处例外放行）
!tools/*.spec

# 数据库与运行产物
*.db
*.sqlite
output/
reports/
*.log
# M3 报告导出与两轮对账的本地输出（含用户路径，不入仓）
build-*/
scan-out*/
round*.json

# 环境与密钥
.env
*.key
*_private/

# 合成样本的本地私有件（不入仓；样本仅留结构与指纹，见 data/README.md §三）
data/**/_private/

# 系统文件
Thumbs.db
Desktop.ini
.DS_Store
